generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id            String          @id @default(cuid())
  timestamp     DateTime        @default(now())
  duration      Int
  audioPath     String
  status        String          @default("recording")
  analysis      Analysis?
  metrics       MeetingMetric[]
  transcription Transcription?

  @@map("meetings")
}

model Transcription {
  id         String   @id @default(cuid())
  meetingId  String   @unique
  text       String
  confidence Float
  timestamp  DateTime @default(now())
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("transcriptions")
}

model Analysis {
  id        String   @id @default(cuid())
  meetingId String   @unique
  summary   String
  sentiment Float
  timestamp DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("analyses")
}

model MeetingMetric {
  timestamp    DateTime
  meetingId    String
  sentiment    Float
  wordCount    Int
  speakingRate Float
  energy       Float
  confidence   Float
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@id([timestamp, meetingId])
  @@map("meeting_metrics")
}
